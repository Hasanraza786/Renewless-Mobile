<resources>

    <!-- Base application theme. -->
    <!-- Dark-only app: native dialogs (date picker, alerts) follow the dark theme with the mint accent. -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorAccent">#B9E58C</item>
        <!-- Native window uses the same background as the React theme. -->
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
    </style>

    <!-- Overrides the date/time picker library's light spinner dialogs: dark surface, mint accent. -->
    <style name="SpinnerDatePickerDialog" parent="Theme.AppCompat.Dialog">
        <item name="colorAccent">#B9E58C</item>
        <item name="android:colorAccent">#B9E58C</item>
        <item name="android:windowBackground">@drawable/picker_dialog_background</item>
        <item name="android:datePickerStyle">@style/SpinnerDatePickerStyle</item>
    </style>
    <style name="SpinnerTimePickerDialog" parent="Theme.AppCompat.Dialog">
        <item name="colorAccent">#B9E58C</item>
        <item name="android:colorAccent">#B9E58C</item>
        <item name="android:windowBackground">@drawable/picker_dialog_background</item>
        <item name="android:timePickerStyle">@style/SpinnerTimePickerStyle</item>
    </style>
</resources>
