<?xml version="1.0" encoding="utf-8"?>
<!-- Approved Small widget: brand row, then either the event block or the quiet block (All clear / Needs update). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<!-- The tile is sized square at runtime on Android 12+ (launcher cells are usually taller than wide). -->
<FrameLayout
    android:id="@+id/widget_tile"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:background="@drawable/widget_background"
    android:padding="15dp">

    <ImageView
        android:id="@+id/quiet_art"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="-9dp"
        android:alpha="0.5"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_loop_happy"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_mark" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif"
                android:letterSpacing="0.07"
                android:text="RENEWLESS"
                android:textColor="#D0D9CC"
                android:textSize="12sp" />

            <ImageView
                android:id="@+id/dot"
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_dot" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/event_block"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/eyebrow"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif"
                    android:letterSpacing="0.08"
                    android:maxLines="1"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/more"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:textColor="#C6D0C3"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/logo"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="6dp"
                    android:importantForAccessibility="no"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="#EDF1E8"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.03"
                android:maxLines="1"
                android:textColor="#EDF1E8"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/line"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:textColor="#C6D0C3"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/quiet_block"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="33dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/quiet_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="#EDF1E8"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/quiet_line"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="sans-serif"
                android:textColor="#C6D0C3"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/quiet_note"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="sans-serif"
                android:textColor="#9DAAA3"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
</FrameLayout>
