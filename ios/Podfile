# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

# react-native-permissions: only the notification permission handler is compiled in.
def node_require(script)
  require Pod::Executable.execute_command('node', ['-p',
    "require.resolve('#{script}', {paths: [process.argv[1]]})", __dir__]).strip
end
node_require('react-native-permissions/scripts/setup.rb')
setup_permissions(['Notifications'])

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

# react-native-firebase: Firebase 12 from CocoaPods (static app linkage); v27+ needs SPM with dynamic frameworks.
$RNFirebaseDisableSPM = true
# Analytics without the IDFA (no IdentitySupport pod), so no App Tracking Transparency prompt is needed.
$RNFirebaseAnalyticsWithoutAdIdSupport = true

target 'Renewless' do
  config = use_native_modules!

  # Google Sign-In's AppCheckCore (Swift) imports these as modules.
  pod 'GoogleUtilities', :modular_headers => true
  pod 'RecaptchaInterop', :modular_headers => true
  # Firebase (Analytics, Crashlytics) Swift pods import these as modules; avoids switching the app to use_frameworks.
  %w[FirebaseCore FirebaseCoreExtension FirebaseCoreInternal FirebaseInstallations FirebaseSessions GoogleDataTransport nanopb].each { |name| pod name, :modular_headers => true }

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
    # Some Google Sign-In dependencies still declare iOS 9/12, below what current Xcode accepts.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build|
        if build.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < min_ios_version_supported.to_f
          build.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = min_ios_version_supported
        end
      end
    end
  end
end
